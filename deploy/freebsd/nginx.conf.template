# Replace __ROOT__ and __PORT__ during installation. Runs entirely as the SSH user.
daemon off;
master_process off;
worker_processes 1;
pid __ROOT__/runtime/nginx-native.pid;
error_log __ROOT__/runtime/nginx-error.log warn;
events { worker_connections 128; }
http {
    access_log off;
    client_body_temp_path __ROOT__/runtime/client_temp;
    proxy_temp_path __ROOT__/runtime/proxy_temp;
    map $http_upgrade $upgrade_connection { default upgrade; '' close; }
    server {
        listen 127.0.0.1:__PORT__;
        server_name _;
        client_max_body_size 0;
        location /ai/ {
            proxy_pass http://unix:__ROOT__/runtime/ai.sock;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_read_timeout 1900s;
            client_max_body_size 64k;
            add_header Cache-Control "no-store" always;
        }
        location / {
            proxy_pass http://127.0.0.1:43646;
            proxy_set_header Accept-Encoding "";
            sub_filter '<meta name="generator" content="OpenList" >' '<meta name="generator" content="OpenList" ><script defer src="/ai/assets/ai.js"></script>';
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $upgrade_connection;
            proxy_read_timeout 3600s;
            proxy_request_buffering off;
            proxy_buffering off;
        }
    }
}
