# Existing OpenList, reachable from the container; do not include a trailing slash.
OPENLIST_URL=http://host.docker.internal:5244
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=
# Prefer a long-lived administrator API token; if set with password, password login refreshes it.
OPENLIST_TOKEN=
MODEL_BASE_URL=https://api.modelbest.cn/v1
MODEL_NAME=MiniCPM-V-4.7-1B
MODEL_API_KEY=
# Optional HTTP(S) CONNECT proxy used only for model requests. Keep credentials server-side.
MODEL_PROXY_URL=
# Send a full-timeline compressed MP4 in one request. Set false for image-only servers.
MODEL_NATIVE_VIDEO=true
# Maximum lossless intermediate file size. Transcoding stops if this budget is exceeded.
VIDEO_WORK_MAX_BYTES=536870912
# Optional OCR settings for burned-in Chinese captions. Fractions are x,y,width,height.
TESSERACT_BIN=tesseract
TESSDATA_DIR=
SUBTITLE_OCR_CROP=0.1,0.87,0.8,0.07
SUBTITLE_OCR_AUTO_CROP=true
# Private compressed evidence cache. Set the size to 0 to disable reuse.
EVIDENCE_CACHE_MAX_BYTES=67108864
EVIDENCE_CACHE_TTL=86400
# Allow only actual media/CDN domains used by your mounts. Redirects are checked too.
# OpenList's own origin is automatically allowed. Prefer OpenList web proxy for private storage.
MEDIA_ALLOWED_HOSTS=*.sharepoint.com,*.1drv.com
AI_GATEWAY_BIND=127.0.0.1
AI_GATEWAY_PORT=8787
# For python-only local evaluation: true. Compose overrides this to false.
AI_PROXY_ENABLED=false
